# Lab webhook: POST /api/integration/notifications  (no trailing slash)
#
# A physical notifications/ directory causes Apache mod_dir to 301-redirect
# /notifications → /notifications/, and clients replay the POST as GET.
# Handler lives in notifications.php; both slash and no-slash rewrite to it.

<IfModule mod_dir.c>
    DirectorySlash Off
</IfModule>

<IfModule mod_rewrite.c>
    RewriteEngine On
    # Preserve POST: internal rewrite (no R= flag), never external redirect.
    RewriteRule ^notifications/?$ notifications.php [L,QSA]
</IfModule>
