# Copy to .env and adjust for your environment. Do not commit .env to version control.

# production | prod — enables production hardening (no debug, no auto CREATE DATABASE, HTTPS redirect)
DCMT_ENV=

# 1 or 0 — only used when DCMT_ENV is not production (defaults to 1 in dev)
DCMT_DEBUG=1

# Application URL (must match your public URL; use https:// in production)
DCMT_APP_URL=http://localhost/dev_dental

# MySQL connection (use a least-privilege user in production; see sql/create_app_db_user.sql)
DCMT_DB_HOST=localhost
DCMT_DB_NAME=u373759666_demo_dental
DCMT_DB_USER=root
DCMT_DB_PASS=

# Optional: directory for logs outside the web root (recommended in production)
# DCMT_LOGS_PATH=/home/your-user/logs/dental

# Optional: directory for encrypted database backups outside htdocs
# DCMT_BACKUP_PATH=/home/your-user/backups/dental-database

# Optional: encrypt backups with OpenSSL (requires openssl CLI). Store key securely, not in git.
# DCMT_BACKUP_KEY=your-long-random-backup-encryption-key

# Optional: mirror encrypted backup to a second directory (off-site mount, NAS, etc.)
# DCMT_BACKUP_MIRROR_PATH=/mnt/offsite/dental-backups

# Clinical record retention period in years (displayed in compliance UI)
# DCMT_PATIENT_RETENTION_YEARS=5

# MySQL TLS (required when database is not on localhost in production)
# DCMT_DB_SSL_CA=/path/to/ca.pem
# DCMT_DB_SSL_VERIFY=1
# DCMT_DB_REQUIRE_SSL=1

# Audit log retention in days (pruned by cron/prune_security_tables.php)
# DCMT_AUDIT_RETENTION_DAYS=365
